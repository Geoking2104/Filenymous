# HTTP port
PORT=3091

# CORS origins (comma-separated). Use * only for local dev.
CORS_ORIGIN=http://localhost:5173,https://geoking2104.github.io,https://filenymous.eu

# VAPID keys — generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@filenymous.eu

# Required for POST /api/push/send (Bearer token)
PUSH_API_SECRET=change-me-push-secret

# Optional path for subscription store (default: ./data/subscriptions.json)
# SUBSCRIPTIONS_PATH=./data/subscriptions.json
