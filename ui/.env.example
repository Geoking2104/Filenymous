# ── Holochain conductor ───────────────────────────────────────────────────────
# WebSocket URL exposed by the Holochain conductor
VITE_HC_URL=ws://localhost:8888

# Holo Web Conductor linker URL (extension / h2hc-linker)
VITE_HWC_LINKER_URL=http://localhost:8090

# ── Bridge micro-service ──────────────────────────────────────────────────────
VITE_BRIDGE_URL=http://localhost:3001

# Shared HMAC secret — must match BRIDGE_SECRET in bridge/.env
VITE_BRIDGE_SECRET=change-me-in-production

# ── Web Push (optional) ───────────────────────────────────────────────────────
# Public VAPID key (base64 URL-safe). When set, NotificationCenter can subscribe
# via PushManager. Private key stays on your push server only.
# Generate: npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY=
