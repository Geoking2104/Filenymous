{
  "name": "filenymous-ui",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node scripts/decode-icons.mjs",
    "prebuild": "node scripts/decode-icons.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "i18n:extract": "i18next --config i18next-parser.config.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:scan": "node scripts/i18n-scan-hardcoded.mjs",
    "i18n": "npm run i18n:extract && npm run i18n:check"
  },
  "dependencies": {
    "@holo-host/web-conductor-client": "^0.1.0",
    "@holochain/client": "^0.20.5",
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.6.0",
    "@scure/btc-signer": "^2.2.0",
    "ethers": "^6.17.0",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.0.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-i18next": "^15.4.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "fake-indexeddb": "^6.2.5",
    "i18next-parser": "^9.3.0",
    "jsdom": "^24.1.3",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.1"
  }
}
