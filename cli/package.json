{
  "name": "filenymous",
  "version": "0.4.1",
  "description": "End-to-end encrypted peer-to-peer file sharing from the terminal or CI (WebRTC, AES-256-GCM, no account, no server storage). Interoperates with https://filenymous.eu/app/",
  "license": "MIT",
  "type": "module",
  "bin": {
    "filenymous": "dist/filenymous.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "p2p",
    "webrtc",
    "file-transfer",
    "e2ee",
    "ci",
    "cli",
    "file-sharing",
    "encryption",
    "privacy",
    "wetransfer-alternative",
    "send-files",
    "nodejs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Geoking2104/Filenymous.git",
    "directory": "cli"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "node-datachannel": "^0.33.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  },
  "homepage": "https://filenymous.eu/app/fonctionnalites/cli-npm/",
  "bugs": {
    "url": "https://github.com/Geoking2104/Filenymous/issues"
  }
}
