# filenymous.eu web root — the app lives at /app/.
# Managed in the repo (deploy/ovh-root/.htaccess) and uploaded by
# deploy-ovh-ui.yml; apply/rollback by hand with ovh-htaccess.yml.
#
# Every redirect target is absolute (https://filenymous.eu/...), so the
# Location header never carries an explicit ":443" (OVH's Apache adds it to
# relative targets). Query strings are preserved; #fragments are never sent to
# the server and browsers re-apply them after a redirect, so #s:/#p2p: links
# keep working.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Deploy backups are never public: 404 for app.bak-<ts>/, www.bak-<ts>/ and
  # any other "<name>.bak-<digits>" that a future deploy might create at the
  # web root (deploy-ovh-sftp.mjs names them <remote>.bak-<yyyymmddhhmmss>).
  # Checked first, on any scheme/host, so nothing redirects to them either.
  # (.htaccess.bak-* stay 403 through the host's default .ht* protection.)
  RewriteRule ^[^/]+\.bak-[0-9]+(/|$) - [R=404,L]

  # Existing rules (were RedirectMatch): / and /index.html -> /app/, from any
  # scheme or host, in one hop (query string kept).
  RewriteRule ^(index\.html)?$ https://filenymous.eu/app/ [R=301,L]

  # Sharewall shortcut: /wall and /wall/new open the "create a wall" screen
  # (#wall-new carries no secret; NE keeps the "#" unescaped). Any scheme or
  # host, one hop.
  RewriteRule ^wall(/new)?/?$ https://filenymous.eu/app/#wall-new [R=301,NE,L]

  # http -> https and www -> apex, in a single hop, path + query kept.
  # On this hosting, https requests reach Apache with SERVER_PORT 443 and
  # plain http with 80 (%{HTTPS} is not reliable behind OVH's front end).
  RewriteCond %{SERVER_PORT} ^80$ [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://filenymous.eu%{REQUEST_URI} [R=301,L]

  # Directory without trailing slash (e.g. /app, /app/faq): add it ourselves
  # instead of mod_dir, whose redirect would carry ":443".
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ https://filenymous.eu/$1/ [R=301,L]
</IfModule>

# Fallback if mod_rewrite were ever unavailable: the original rules, with
# absolute targets.
<IfModule !mod_rewrite.c>
  RedirectMatch 301 ^/$ https://filenymous.eu/app/
  RedirectMatch 301 ^/index\.html$ https://filenymous.eu/app/
</IfModule>

# HSTS on HTTPS responses only (https reaches Apache with SERVER_PORT 443 on
# this hosting; plain http with 80 and is redirected above). One year, no
# includeSubDomains: ftp.filenymous.eu (OVH default CNAME) has no valid
# certificate. No preload (owner decision, hard to undo).
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{SERVER_PORT} == '443'"
</IfModule>

# WebAssembly must be served as application/wasm so browsers can stream-
# compile it (WebAssembly.instantiateStreaming rejects other MIME types).
# Applies to /app/ and below.
<IfModule mod_mime.c>
  AddType application/wasm .wasm
</IfModule>
